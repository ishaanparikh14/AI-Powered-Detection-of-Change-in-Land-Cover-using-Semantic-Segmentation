# ─────────────────────────────────────────────
#  Western Ghats Monitor — .gitignore
# ─────────────────────────────────────────────

# ── Model weights (large binary files) ───────
checkpoints/
*.pth
*.pt
*.onnx
*.pkl

# ── Dataset (never commit training data) ─────
dataset/

# ── Python cache ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual environments ───────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Environment variables ──────────────────────
.env
.env.local
.env.*.local

# ── Generated output (runtime artefacts) ──────
# reports/ is intentionally tracked — contains sample PDF outputs
exports/

# ── Node / React ───────────────────────────────
frontend/node_modules/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.production
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Google Earth Engine credentials ───────────
.config/earthengine/
credentials

# ── IDE / Editor ───────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS artefacts ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ──────────────────────────────────────
*.log
logs/
